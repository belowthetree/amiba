<?xml version="1.0" encoding="utf-8"?>
<!-- 变形虫桌面卡片 · image 布局：标题行 + 图片 + footer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EEEEEE"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:textColor="#88FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 占位：复用 lines 布局的 id，image 布局恒为 GONE -->
    <TextView android:id="@+id/widget_line_1" style="@style/WidgetLine" android:visibility="gone" />
    <TextView android:id="@+id/widget_line_2" style="@style/WidgetLine" android:visibility="gone" />
    <TextView android:id="@+id/widget_line_3" style="@style/WidgetLine" android:visibility="gone" />
    <TextView android:id="@+id/widget_line_4" style="@style/WidgetLine" android:visibility="gone" />
    <TextView android:id="@+id/widget_line_5" style="@style/WidgetLine" android:visibility="gone" />
    <TextView android:id="@+id/widget_line_6" style="@style/WidgetLine" android:visibility="gone" />
</LinearLayout>
