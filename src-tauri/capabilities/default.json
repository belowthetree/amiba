{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$TEMP/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$HOME/**" }, { "path": "$TEMP/**" }]
    },
    "android-installer:default"
  ]
}
